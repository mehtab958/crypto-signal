// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
//
// Crypto Futures Pump / Dump Scanner  —  20 coins, real-time (tick-by-tick) early detection
// ---------------------------------------------------------------------------------------------
// Nothing can predict a pump before it starts. This catches the FIRST SECONDS of one, using what
// institutional momentum-ignition detectors look for:
//   1. VOLUME EXPLOSION   current 1m volume ≥ 3 × the 30-bar average (checked INTRABAR, every tick)
//   2. PRICE IMPULSE      candle move ≥ 0.6 %  or 3-candle move ≥ 1.2 %
//   3. BREAKOUT           price breaks the 30-bar high (pump) / low (dump)
//   4. CANDLE CONTROL     close in the top 35 % of the range (pump) / bottom 35 % (dump)
// "HEATING" = volume building + price starting to move → early warning before a full signal.
//
// ALERT: Create Alert → Condition "PumpDump Scanner" → "Any alert() function call" →
//        Trigger "Once per bar" is NOT needed (the script de-duplicates) → tick "Show pop-up",
//        "Play sound", "Notify on app". The coin names pop up on your screen / phone.
// Put this on a liquid 1-minute chart (e.g. BINANCE:BTCUSDT.P, 1m) so it updates every tick.
// Intrabar signals are early by design — a signal can fade before the candle closes. Use the SL.
// ---------------------------------------------------------------------------------------------
//@version=6
indicator("Crypto Futures Pump/Dump Scanner [20 coins • real-time]", shorttitle = "PumpDump Scanner", overlay = true)

// ═════════════════════════════════════════════════════════════════════════════════════════════
// INPUTS
// ═════════════════════════════════════════════════════════════════════════════════════════════
const string G1 = "1 · Detection"
const string G2 = "2 · Trade levels"
const string G3 = "3 · Coins (Binance USDT perpetuals — change to any symbol)"

tf        = input.timeframe("1", "Scan timeframe", group = G1)
volX      = input.float(3.0, "Volume spike ≥ × 30-bar avg", minval = 1.5, step = 0.25, group = G1)
pctX      = input.float(0.6, "1-candle move ≥ %", minval = 0.1, step = 0.1, group = G1)
pct3X     = input.float(1.2, "3-candle move ≥ %", minval = 0.2, step = 0.1, group = G1)
hlLen     = input.int(30, "Breakout of N-bar high / low", minval = 5, group = G1)
useBrk    = input.bool(true, "Require breakout", group = G1)
heatAlert = input.bool(false, "Also alert on HEATING (early warning, more noise)", group = G1)
coolBars  = input.int(5, "Cooldown per coin (bars)", minval = 0, group = G1)

slAtr     = input.float(1.5, "Stop-loss (× ATR of scan TF)", minval = 0.5, step = 0.25, group = G2)
tp1R      = input.float(1.5, "TP1 (R)", minval = 0.5, step = 0.5, group = G2)
tp2R      = input.float(3.0, "TP2 (R)", minval = 0.5, step = 0.5, group = G2)

s01 = input.symbol("BINANCE:BTCUSDT.P", "01", group = G3)
s02 = input.symbol("BINANCE:ETHUSDT.P", "02", group = G3)
s03 = input.symbol("BINANCE:SOLUSDT.P", "03", group = G3)
s04 = input.symbol("BINANCE:XRPUSDT.P", "04", group = G3)
s05 = input.symbol("BINANCE:DOGEUSDT.P", "05", group = G3)
s06 = input.symbol("BINANCE:BNBUSDT.P", "06", group = G3)
s07 = input.symbol("BINANCE:ADAUSDT.P", "07", group = G3)
s08 = input.symbol("BINANCE:AVAXUSDT.P", "08", group = G3)
s09 = input.symbol("BINANCE:LINKUSDT.P", "09", group = G3)
s10 = input.symbol("BINANCE:SUIUSDT.P", "10", group = G3)
s11 = input.symbol("BINANCE:1000PEPEUSDT.P", "11", group = G3)
s12 = input.symbol("BINANCE:WIFUSDT.P", "12", group = G3)
s13 = input.symbol("BINANCE:ARBUSDT.P", "13", group = G3)
s14 = input.symbol("BINANCE:OPUSDT.P", "14", group = G3)
s15 = input.symbol("BINANCE:APTUSDT.P", "15", group = G3)
s16 = input.symbol("BINANCE:NEARUSDT.P", "16", group = G3)
s17 = input.symbol("BINANCE:INJUSDT.P", "17", group = G3)
s18 = input.symbol("BINANCE:TIAUSDT.P", "18", group = G3)
s19 = input.symbol("BINANCE:SEIUSDT.P", "19", group = G3)
s20 = input.symbol("BINANCE:LTCUSDT.P", "20", group = G3)

// ═════════════════════════════════════════════════════════════════════════════════════════════
// PER-COIN DETECTION (runs inside each coin's own data)
// sig:  1 = PUMP   -1 = DUMP   2 = heating up   -2 = heating down   0 = nothing
// ═════════════════════════════════════════════════════════════════════════════════════════════
f_scan() =>
    float vAvg = ta.sma(volume, 30)[1]
    float vr   = vAvg > 0 ? volume / vAvg : 0.0
    float chg  = (close - open) / open * 100
    float chg3 = (close - close[3]) / close[3] * 100
    float hh   = ta.highest(high, hlLen)[1]
    float ll   = ta.lowest(low, hlLen)[1]
    float rng  = high - low
    float pos  = rng > 0 ? (close - low) / rng : 0.5
    float atr  = ta.atr(14)
    bool  up   = chg >= pctX or chg3 >= pct3X
    bool  dn   = chg <= -pctX or chg3 <= -pct3X
    int   sig  = 0
    if vr >= volX and up and pos >= 0.65 and (not useBrk or close > hh)
        sig := 1
    else if vr >= volX and dn and pos <= 0.35 and (not useBrk or close < ll)
        sig := -1
    else if vr >= volX * 0.6 and chg >= pctX * 0.5
        sig := 2
    else if vr >= volX * 0.6 and chg <= -pctX * 0.5
        sig := -2
    [close, chg, vr, sig, atr]

scan(string s) => request.security(s, tf, f_scan(), ignore_invalid_symbol = true)

[c01, g01, v01, k01, a01] = scan(s01)
[c02, g02, v02, k02, a02] = scan(s02)
[c03, g03, v03, k03, a03] = scan(s03)
[c04, g04, v04, k04, a04] = scan(s04)
[c05, g05, v05, k05, a05] = scan(s05)
[c06, g06, v06, k06, a06] = scan(s06)
[c07, g07, v07, k07, a07] = scan(s07)
[c08, g08, v08, k08, a08] = scan(s08)
[c09, g09, v09, k09, a09] = scan(s09)
[c10, g10, v10, k10, a10] = scan(s10)
[c11, g11, v11, k11, a11] = scan(s11)
[c12, g12, v12, k12, a12] = scan(s12)
[c13, g13, v13, k13, a13] = scan(s13)
[c14, g14, v14, k14, a14] = scan(s14)
[c15, g15, v15, k15, a15] = scan(s15)
[c16, g16, v16, k16, a16] = scan(s16)
[c17, g17, v17, k17, a17] = scan(s17)
[c18, g18, v18, k18, a18] = scan(s18)
[c19, g19, v19, k19, a19] = scan(s19)
[c20, g20, v20, k20, a20] = scan(s20)

syms = array.from(s01, s02, s03, s04, s05, s06, s07, s08, s09, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, s20)
cs   = array.from(c01, c02, c03, c04, c05, c06, c07, c08, c09, c10, c11, c12, c13, c14, c15, c16, c17, c18, c19, c20)
gs   = array.from(g01, g02, g03, g04, g05, g06, g07, g08, g09, g10, g11, g12, g13, g14, g15, g16, g17, g18, g19, g20)
vs   = array.from(v01, v02, v03, v04, v05, v06, v07, v08, v09, v10, v11, v12, v13, v14, v15, v16, v17, v18, v19, v20)
ks   = array.from(k01, k02, k03, k04, k05, k06, k07, k08, k09, k10, k11, k12, k13, k14, k15, k16, k17, k18, k19, k20)
ats  = array.from(a01, a02, a03, a04, a05, a06, a07, a08, a09, a10, a11, a12, a13, a14, a15, a16, a17, a18, a19, a20)

// ═════════════════════════════════════════════════════════════════════════════════════════════
// HELPERS
// ═════════════════════════════════════════════════════════════════════════════════════════════
nm(string s) =>
    array<string> parts = str.split(s, ":")
    string b = parts.size() > 1 ? parts.get(1) : s
    str.replace_all(str.replace_all(b, ".P", ""), "USDT", "")

fmt(float x) => na(x) ? "—" : str.tostring(x, x >= 100 ? "#.##" : x >= 1 ? "#.####" : "#.########")

// ═════════════════════════════════════════════════════════════════════════════════════════════
// ALERTS (fire intrabar, the moment a coin qualifies; one alert per coin per direction per bar)
// ═════════════════════════════════════════════════════════════════════════════════════════════
var   array<int> lastSig = array.new_int(20, -100000)
varip int    curT   = 0
varip string fired  = ""
varip string recent = ""

if time != curT
    curT  := time
    fired := ""

string msg = ""
for i = 0 to 19
    int   k    = nz(ks.get(i))
    float px   = cs.get(i)
    float atrI = ats.get(i)
    bool  cool = bar_index - lastSig.get(i) > coolBars
    bool  full = k == 1 or k == -1
    bool  heat = heatAlert and (k == 2 or k == -2)
    if full and cool
        lastSig.set(i, bar_index)
    if (full or heat) and (cool or bar_index == lastSig.get(i)) and not na(px) and not na(atrI)
        string key = str.tostring(i) + ":" + str.tostring(k) + "|"
        if not str.contains(fired, key)
            fired += key
            int   d   = k > 0 ? 1 : -1
            float r   = slAtr * atrI
            string ln = (k == 1 ? "🚀 PUMP " : k == -1 ? "🔻 DUMP " : k == 2 ? "🔥 HEATING ↑ " : "🧊 HEATING ↓ ") + nm(syms.get(i)) +
                 "  " + (gs.get(i) >= 0 ? "+" : "") + str.tostring(gs.get(i), "#.##") + "%  vol " + str.tostring(vs.get(i), "#.#") + "x" +
                 " | " + (d == 1 ? "LONG" : "SHORT") + " " + fmt(px) +
                 " SL " + fmt(px - d * r) + " TP1 " + fmt(px + d * r * tp1R) + " TP2 " + fmt(px + d * r * tp2R)
            msg += ln + "\n"
            string ts = str.format_time(timenow, "HH:mm:ss", syminfo.timezone)
            array<string> lines = str.split(ts + "  " + ln + "\n" + recent, "\n")
            recent := array.join(lines.size() > 8 ? lines.slice(0, 8) : lines, "\n")

if str.length(msg) > 0
    alert(msg, alert.freq_all)

// ═════════════════════════════════════════════════════════════════════════════════════════════
// ON-SCREEN SCANNER TABLE
// ═════════════════════════════════════════════════════════════════════════════════════════════
var table tb  = table.new(position.top_right, 5, 21, bgcolor = color.new(color.black, 10), border_color = color.new(color.gray, 70), border_width = 1)
var table logTb = table.new(position.bottom_left, 1, 2, bgcolor = color.new(color.black, 10))

if barstate.islast
    table.cell(tb, 0, 0, "Coin",   text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 0, "Price",  text_color = color.white, text_size = size.small)
    table.cell(tb, 2, 0, tf + "m %", text_color = color.white, text_size = size.small)
    table.cell(tb, 3, 0, "Vol ×",  text_color = color.white, text_size = size.small)
    table.cell(tb, 4, 0, "Status", text_color = color.white, text_size = size.small)
    for i = 0 to 19
        int    k  = nz(ks.get(i))
        float  g  = gs.get(i)
        float  v  = vs.get(i)
        string st = k == 1 ? "🚀 PUMP" : k == -1 ? "🔻 DUMP" : k == 2 ? "🔥 heating ↑" : k == -2 ? "🧊 heating ↓" : "·"
        color  bg = k == 1 ? color.new(color.green, 30) : k == -1 ? color.new(color.red, 30) : k == 2 ? color.new(color.orange, 60) : k == -2 ? color.new(color.blue, 60) : na
        table.cell(tb, 0, i + 1, nm(syms.get(i)), text_color = color.white, text_size = size.small, bgcolor = bg, text_halign = text.align_left)
        table.cell(tb, 1, i + 1, fmt(cs.get(i)), text_color = color.silver, text_size = size.small, bgcolor = bg)
        table.cell(tb, 2, i + 1, na(g) ? "—" : str.tostring(g, "#.##"), text_color = na(g) ? color.gray : g >= 0 ? color.lime : color.red, text_size = size.small, bgcolor = bg)
        table.cell(tb, 3, i + 1, na(v) ? "—" : str.tostring(v, "#.#"), text_color = nz(v) >= volX ? color.yellow : color.silver, text_size = size.small, bgcolor = bg)
        table.cell(tb, 4, i + 1, st, text_color = color.white, text_size = size.small, bgcolor = bg)
    table.cell(logTb, 0, 0, "Latest signals", text_color = color.yellow, text_size = size.small, text_halign = text.align_left)
    table.cell(logTb, 0, 1, str.length(recent) > 0 ? recent : "waiting for signals… (runs live on every tick)", text_color = color.white, text_size = size.small, text_halign = text.align_left)
