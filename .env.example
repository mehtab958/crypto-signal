# Required
ANTHROPIC_API_KEY=sk-ant-...
TELEGRAM_BOT_TOKEN=123456:ABC...

# Optional
BOT_NAME=SignalBot
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=medium            # low | medium | high | xhigh | max
DEFAULT_MODE=fun                # fun | regular
HISTORY_TURNS=12                # past exchanges remembered per chat
ENABLE_WEB_SEARCH=true
BINANCE_BASE_URL=https://api.binance.com   # candles; falls back to OKX automatically if blocked
OKX_BASE_URL=https://www.okx.com
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=              # optional demo key for higher rate limits
