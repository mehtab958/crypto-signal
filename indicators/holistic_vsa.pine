// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
//
// Holistic VSA  —  Volume Spread Analysis (Tom Williams / Wyckoff) with Background → Signal → Confirmation
// ---------------------------------------------------------------------------------------------
// VSA reads every bar through 3 things: VOLUME (effort), SPREAD (result) and CLOSE position.
// "Holistic" = never trade one bar alone:
//   1. BACKGROUND   Sum of recent Signs of Strength vs Signs of Weakness (climaxes, stopping volume,
//                   shakeouts, upthrusts...) decides which side professionals are on.
//   2. SIGNAL       A low-risk trigger in harmony with the background:
//                     buy  → No Supply, Test, Spring            (after strength)
//                     sell → No Demand, Test of supply / pseudo-upthrust (after weakness)
//   3. CONFIRMATION The next 1-3 bars must close beyond the signal bar (above high / below low).
//   4. TRADE        Entry on the confirmation close, SL beyond the signal bar, TP1/2/3 = 2R/3R/5R.
//
// Signs of STRENGTH (below bars, green):  SC Selling Climax · SV Stopping Volume · SO Shakeout
//                                         SP Spring · T Test · NS No Supply · EU Effort Up
// Signs of WEAKNESS (above bars, red):    BC Buying Climax · UT Upthrust · ER End of Rising market
//                                         PU Pseudo-upthrust · ND No Demand · ED Effort Down
// Works on any market with volume (crypto & stocks = real volume; forex = tick volume).
// ---------------------------------------------------------------------------------------------
//@version=6
indicator("Holistic VSA [Background • Signal • Confirmation]", shorttitle = "Holistic VSA",
     overlay = true, max_labels_count = 500, max_lines_count = 500)

// ═════════════════════════════════════════════════════════════════════════════════════════════
// INPUTS
// ═════════════════════════════════════════════════════════════════════════════════════════════
const string G1 = "1 · Bar classification"
const string G2 = "2 · Background (holistic context)"
const string G3 = "3 · Entry, Stop & Targets"
const string G4 = "4 · Visuals & Stats"

avgLen    = input.int(20, "Average length (volume & spread)", minval = 5, group = G1)
ultraMult = input.float(2.0, "Ultra-high volume ≥ × avg", minval = 1.2, step = 0.1, group = G1)
highMult  = input.float(1.3, "High volume ≥ × avg", minval = 1.0, step = 0.1, group = G1)
wideMult  = input.float(1.3, "Wide spread ≥ × avg", minval = 1.0, step = 0.1, group = G1)
vwideMult = input.float(1.8, "Very wide spread ≥ × avg", minval = 1.2, step = 0.1, group = G1)
narrMult  = input.float(0.7, "Narrow spread ≤ × avg", minval = 0.2, maxval = 1.0, step = 0.05, group = G1)
hlLen     = input.int(20, "New high / low lookback", minval = 5, group = G1)

bgLen     = input.int(20, "Background lookback (bars)", minval = 5, group = G2)
bgMin     = input.int(3, "Min background points", minval = 1, group = G2, tooltip = "Climax/Shakeout/Upthrust = 3, Stopping Volume/End of Rising = 2, others = 1.")
useTrend  = input.bool(false, "Also require EMA trend", group = G2, tooltip = "Off = pure VSA (can catch reversals after climaxes). On = only trade with the EMA.")
trendLen  = input.int(50, "Trend EMA", minval = 10, group = G2)

confBars  = input.int(3, "Bars allowed for confirmation", minval = 1, maxval = 10, group = G3)
slBuf     = input.float(0.1, "SL buffer (× ATR)", minval = 0, step = 0.05, group = G3)
maxRisk   = input.float(3.0, "Max SL distance (× ATR)", minval = 0.5, step = 0.25, group = G3)
tp1R      = input.float(2.0, "TP1 (R)", minval = 0.5, step = 0.5, group = G3)
tp2R      = input.float(3.0, "TP2 (R)", minval = 0.5, step = 0.5, group = G3)
tp3R      = input.float(5.0, "TP3 (R)", minval = 0.5, step = 0.5, group = G3)
moveBE    = input.bool(true, "SL → break-even after TP1, → TP1 after TP2", group = G3)

showLbl   = input.bool(true, "Show VSA bar labels", group = G4)
colorBars = input.bool(true, "Color bars by volume (ultra / high / low)", group = G4)
statDays  = input.int(30, "Stats lookback (days)", minval = 1, maxval = 365, group = G4)
showTbl   = input.bool(true, "Dashboard", group = G4)

// ═════════════════════════════════════════════════════════════════════════════════════════════
// BAR ANATOMY
// ═════════════════════════════════════════════════════════════════════════════════════════════
atr     = ta.atr(14)
spread  = high - low
avgVol  = ta.sma(volume, avgLen)
avgSpr  = ta.sma(spread, avgLen)
volRel  = avgVol > 0 ? volume / avgVol : 1.0
cp      = spread > 0 ? (close - low) / spread : 0.5

ultraV  = volRel >= ultraMult
highV   = volRel >= highMult
lowV    = volume < volume[1] and volume < volume[2]
wide    = spread >= wideMult * avgSpr
vwide   = spread >= vwideMult * avgSpr
narrow  = spread <= narrMult * avgSpr
cHigh   = cp >= 0.66
cLow    = cp <= 0.33
upBar   = close > close[1]
dnBar   = close < close[1]

prevLo  = ta.lowest(low, hlLen)[1]
prevHi  = ta.highest(high, hlLen)[1]
newLow  = low < prevLo
newHigh = high > prevHi
ema20   = ta.ema(close, 20)
dnCtx   = ema20 < ema20[5] or close < ema20
upCtx   = ema20 > ema20[5] or close > ema20
emaT    = ta.ema(close, trendLen)
lo10    = ta.lowest(low, 10)[1]
hi10    = ta.highest(high, 10)[1]

// ═════════════════════════════════════════════════════════════════════════════════════════════
// VSA SIGNALS (priority order → one label per side per bar)
// ═════════════════════════════════════════════════════════════════════════════════════════════
// Strength
isSC = newLow and vwide and ultraV and cp >= 0.4 and dnCtx                                   // Selling Climax
isSO = not isSC and newLow and wide and highV and cHigh                                        // Shakeout
isSV = not isSC and not isSO and highV and dnBar and cp >= 0.4 and low <= lo10 and dnCtx   // Stopping Volume
isSP = not isSC and not isSO and not isSV and newLow and close > prevLo and cp >= 0.5 and lowV // Spring (low-volume shakeout)
isT  = not isSC and not isSO and not isSV and not isSP and low < low[1] and cHigh and lowV and not wide      // Test
isNS = not isSC and not isSO and not isSV and not isSP and not isT and dnBar and narrow and lowV and cp > 0.3 // No Supply
isEU = not isSC and not isSO and not isSV and upBar and wide and highV and cHigh               // Effort to rise

// Weakness
isBC = newHigh and vwide and ultraV and cp <= 0.6 and upCtx                                   // Buying Climax
isUT = not isBC and newHigh and highV and cLow                                                // Upthrust
isER = not isBC and not isUT and upBar and ultraV and narrow and high >= hi10            // End of rising market
isPU = not isBC and not isUT and not isER and newHigh and close < prevHi and cp <= 0.5 and lowV             // Pseudo-upthrust (test of supply)
isND = not isBC and not isUT and not isER and not isPU and upBar and narrow and lowV and cp < 0.7           // No Demand
isED = not isBC and not isUT and not isER and dnBar and wide and highV and cLow                // Effort to fall

// ═════════════════════════════════════════════════════════════════════════════════════════════
// BACKGROUND (holistic): weighted Signs of Strength vs Weakness over the last N bars
// ═════════════════════════════════════════════════════════════════════════════════════════════
strPts  = (isSC or isSO ? 3 : 0) + (isSV ? 2 : 0) + (isSP or isT or isNS or isEU ? 1 : 0)
weakPts = (isBC or isUT ? 3 : 0) + (isER ? 2 : 0) + (isPU or isND or isED ? 1 : 0)
bgStr   = math.sum(strPts, bgLen)
bgWeak  = math.sum(weakPts, bgLen)
bgBull  = bgStr >= bgMin and bgStr > bgWeak
bgBear  = bgWeak >= bgMin and bgWeak > bgStr

// ═════════════════════════════════════════════════════════════════════════════════════════════
// SETUP → CONFIRMATION
// ═════════════════════════════════════════════════════════════════════════════════════════════
buySetup  = (isNS or isT or isSP) and bgBull[1] and (not useTrend or close > emaT)
sellSetup = (isND or isPU) and bgBear[1] and (not useTrend or close < emaT)

var int   bBar = na
var float bHi  = na
var float bLo  = na
var string bWhy = ""
var int   sBar = na
var float sHi  = na
var float sLo  = na
var string sWhy = ""

bool longSig  = false
bool shortSig = false

// check pending setups first (confirmation must come on a LATER bar)
if not na(bBar)
    if low < bLo or bar_index - bBar > confBars
        bBar := na
    else if close > bHi and upBar
        longSig := true
        bBar := na
if not na(sBar)
    if high > sHi or bar_index - sBar > confBars
        sBar := na
    else if close < sLo and dnBar
        shortSig := true
        sBar := na

if buySetup
    bBar := bar_index
    bHi  := high
    bLo  := math.min(low, low[1])
    bWhy := isSP ? "Spring" : isT ? "Test" : "No Supply"
if sellSetup
    sBar := bar_index
    sHi  := math.max(high, high[1])
    sLo  := low
    sWhy := isPU ? "Pseudo-upthrust" : "No Demand"

// ═════════════════════════════════════════════════════════════════════════════════════════════
// TRADE TRACKING (one at a time) + STATS
// ═════════════════════════════════════════════════════════════════════════════════════════════
var int   dir    = 0
var float tEntry = na
var float tRisk  = na
var float tSL    = na
var float tTP1   = na
var float tTP2   = na
var float tTP3   = na
var int   tBar   = na
var bool  h1     = false
var bool  h2     = false
var bool  tStat  = false
var line  lnE    = na
var line  lnS    = na
var line  ln1    = na
var line  ln2    = na
var line  ln3    = na
var string lastWhy = ""

var int   nTr  = 0
var int   nWin = 0
var int   nT1  = 0
var int   nT2  = 0
var int   nT3  = 0
var int   nSL  = 0
var float sumR = 0.0

inStats = time >= timenow - statDays * 86400000

if dir != 0 and bar_index > tBar
    bool slHit = dir == 1 ? low <= tSL : high >= tSL
    bool t1    = dir == 1 ? high >= tTP1 : low <= tTP1
    bool t2    = dir == 1 ? high >= tTP2 : low <= tTP2
    bool t3    = dir == 1 ? high >= tTP3 : low <= tTP3
    float  res = na
    string out = ""
    if slHit
        float realized = (h1 ? tp1R / 3 : 0.0) + (h2 ? tp2R / 3 : 0.0)
        float remFrac  = 1.0 - (h1 ? 1.0 / 3 : 0.0) - (h2 ? 1.0 / 3 : 0.0)
        res := realized + remFrac * (tSL - tEntry) * dir / tRisk
        out := h2 ? "TP2 ✓" : h1 ? "TP1 ✓" : "SL ✗"
    else
        if t1 and not h1
            h1 := true
            if moveBE
                tSL := tEntry
        if t2 and not h2
            h2 := true
            if moveBE
                tSL := tTP1
        if t3
            res := (tp1R + tp2R + tp3R) / 3
            out := "TP3 ✓"
    line.set_x2(lnE, bar_index)
    line.set_x2(lnS, bar_index)
    line.set_x2(ln1, bar_index)
    line.set_x2(ln2, bar_index)
    line.set_x2(ln3, bar_index)
    line.set_y1(lnS, tSL)
    line.set_y2(lnS, tSL)
    if not na(res)
        if tStat
            nTr  += 1
            sumR += res
            if res > 0
                nWin += 1
            if out == "TP3 ✓"
                nT3 += 1
            else if out == "TP2 ✓"
                nT2 += 1
            else if out == "TP1 ✓"
                nT1 += 1
            else
                nSL += 1
        label.new(bar_index, dir == 1 ? high : low, out + "  " + (res >= 0 ? "+" : "") + str.tostring(res, "#.##") + "R",
             style = dir == 1 ? label.style_label_down : label.style_label_up,
             color = res > 0 ? color.new(color.green, 20) : color.new(color.red, 20), textcolor = color.white, size = size.small)
        dir := 0

bool buyNow  = false
bool sellNow = false

if dir == 0 and (longSig or shortSig)
    int   d    = longSig ? 1 : -1
    float sl   = d == 1 ? bLo - slBuf * atr : sHi + slBuf * atr
    float risk = (close - sl) * d
    if risk > 0 and risk <= maxRisk * atr
        dir    := d
        tEntry := close
        tRisk  := risk
        tSL    := sl
        tTP1   := close + d * risk * tp1R
        tTP2   := close + d * risk * tp2R
        tTP3   := close + d * risk * tp3R
        tBar   := bar_index
        h1     := false
        h2     := false
        tStat  := inStats
        buyNow  := d == 1
        sellNow := d == -1
        lastWhy := d == 1 ? bWhy : sWhy
        lnE := line.new(bar_index, tEntry, bar_index + 1, tEntry, color = color.blue, width = 2)
        lnS := line.new(bar_index, tSL, bar_index + 1, tSL, color = color.red, width = 2)
        ln1 := line.new(bar_index, tTP1, bar_index + 1, tTP1, color = color.new(color.green, 40), style = line.style_dashed)
        ln2 := line.new(bar_index, tTP2, bar_index + 1, tTP2, color = color.new(color.green, 20), style = line.style_dashed)
        ln3 := line.new(bar_index, tTP3, bar_index + 1, tTP3, color = color.green, width = 2)
        string txt = (d == 1 ? "BUY" : "SELL") + "  (" + lastWhy + " confirmed)" +
             "\nEntry: " + str.tostring(tEntry, format.mintick) +
             "\nSL: "    + str.tostring(tSL, format.mintick) +
             "\nTP1: "   + str.tostring(tTP1, format.mintick) + "  (" + str.tostring(tp1R) + "R)" +
             "\nTP2: "   + str.tostring(tTP2, format.mintick) + "  (" + str.tostring(tp2R) + "R)" +
             "\nTP3: "   + str.tostring(tTP3, format.mintick) + "  (" + str.tostring(tp3R) + "R)"
        label.new(bar_index, d == 1 ? low : high, txt, style = d == 1 ? label.style_label_up : label.style_label_down,
             color = d == 1 ? color.new(color.green, 0) : color.new(color.red, 0), textcolor = color.white, size = size.small)
        alert(syminfo.ticker + " VSA " + (d == 1 ? "BUY" : "SELL") + " (" + lastWhy + ") | Entry " + str.tostring(tEntry, format.mintick) +
             " | SL " + str.tostring(tSL, format.mintick) + " | TP1 " + str.tostring(tTP1, format.mintick) +
             " | TP2 " + str.tostring(tTP2, format.mintick) + " | TP3 " + str.tostring(tTP3, format.mintick), alert.freq_once_per_bar_close)

alertcondition(buyNow, "VSA Buy", "Holistic VSA BUY on {{ticker}} at {{close}}")
alertcondition(sellNow, "VSA Sell", "Holistic VSA SELL on {{ticker}} at {{close}}")
alertcondition(isSC or isSV or isSO, "VSA major strength", "VSA major sign of STRENGTH (climax / stopping volume / shakeout) on {{ticker}}")
alertcondition(isBC or isUT or isER, "VSA major weakness", "VSA major sign of WEAKNESS (climax / upthrust / end of rise) on {{ticker}}")

// ═════════════════════════════════════════════════════════════════════════════════════════════
// VISUALS
// ═════════════════════════════════════════════════════════════════════════════════════════════
cStr  = color.new(color.lime, 0)
cStr2 = color.new(color.teal, 0)
cWk   = color.new(color.red, 0)
cWk2  = color.new(color.orange, 0)
plotshape(showLbl and isSC, "Selling Climax",   shape.labelup,   location.belowbar, cStr,  text = "SC", textcolor = color.black, size = size.tiny)
plotshape(showLbl and isSO, "Shakeout",         shape.labelup,   location.belowbar, cStr,  text = "SO", textcolor = color.black, size = size.tiny)
plotshape(showLbl and isSV, "Stopping Volume",  shape.labelup,   location.belowbar, cStr,  text = "SV", textcolor = color.black, size = size.tiny)
plotshape(showLbl and isSP, "Spring",           shape.triangleup, location.belowbar, cStr2, text = "SP", textcolor = cStr2, size = size.tiny)
plotshape(showLbl and isT,  "Test",             shape.triangleup, location.belowbar, cStr2, text = "T",  textcolor = cStr2, size = size.tiny)
plotshape(showLbl and isNS, "No Supply",        shape.triangleup, location.belowbar, cStr2, text = "NS", textcolor = cStr2, size = size.tiny)
plotshape(showLbl and isEU, "Effort Up",        shape.circle,    location.belowbar, cStr2, text = "EU", textcolor = cStr2, size = size.tiny)
plotshape(showLbl and isBC, "Buying Climax",    shape.labeldown, location.abovebar, cWk,   text = "BC", textcolor = color.white, size = size.tiny)
plotshape(showLbl and isUT, "Upthrust",         shape.labeldown, location.abovebar, cWk,   text = "UT", textcolor = color.white, size = size.tiny)
plotshape(showLbl and isER, "End of Rise",      shape.labeldown, location.abovebar, cWk,   text = "ER", textcolor = color.white, size = size.tiny)
plotshape(showLbl and isPU, "Pseudo-upthrust",  shape.triangledown, location.abovebar, cWk2, text = "PU", textcolor = cWk2, size = size.tiny)
plotshape(showLbl and isND, "No Demand",        shape.triangledown, location.abovebar, cWk2, text = "ND", textcolor = cWk2, size = size.tiny)
plotshape(showLbl and isED, "Effort Down",      shape.circle,    location.abovebar, cWk2, text = "ED", textcolor = cWk2, size = size.tiny)

barcolor(colorBars ? (ultraV ? (close >= open ? color.new(color.lime, 0) : color.new(color.fuchsia, 0)) : highV ? (close >= open ? color.new(color.teal, 0) : color.new(color.red, 0)) : lowV ? color.new(color.gray, 20) : na) : na)
plot(useTrend ? emaT : na, "Trend EMA", color = color.new(color.orange, 0))
bgcolor(bgBull ? color.new(color.green, 94) : bgBear ? color.new(color.red, 94) : na, title = "Background")

var table tb = table.new(position.top_right, 2, 12, bgcolor = color.new(color.black, 15), border_color = color.new(color.gray, 60), border_width = 1)
row(int r, string k, string v, color c) =>
    table.cell(tb, 0, r, k, text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, r, v, text_color = c, text_size = size.small, text_halign = text.align_right)

if showTbl and barstate.islast
    float wr = nTr > 0 ? 100.0 * nWin / nTr : na
    row(0, "Holistic VSA", "last " + str.tostring(statDays) + " days", color.white)
    row(1, "Background", bgBull ? "STRENGTH — look to buy" : bgBear ? "WEAKNESS — look to sell" : "neutral — wait", bgBull ? color.lime : bgBear ? color.red : color.gray)
    row(2, "Strength / Weakness pts", str.tostring(bgStr) + " / " + str.tostring(bgWeak), color.white)
    row(3, "This bar", "vol " + str.tostring(volRel, "#.0") + "× · spread " + str.tostring(avgSpr > 0 ? spread / avgSpr : 0, "#.0") + "× · close " + (cHigh ? "high" : cLow ? "low" : "mid"), color.silver)
    row(4, "Closed signals", str.tostring(nTr), color.white)
    row(5, "Win rate (TP1+)", na(wr) ? "—" : str.tostring(wr, "#.0") + "%", na(wr) ? color.gray : wr >= 40 ? color.lime : color.orange)
    row(6, "TP3 / TP2 / TP1", str.tostring(nT3) + " / " + str.tostring(nT2) + " / " + str.tostring(nT1), color.lime)
    row(7, "Stopped out", str.tostring(nSL), color.red)
    row(8, "Net result", (sumR >= 0 ? "+" : "") + str.tostring(sumR, "#.##") + " R", sumR >= 0 ? color.lime : color.red)
    row(9, "Avg per trade", nTr > 0 ? str.tostring(sumR / nTr, "#.##") + " R" : "—", sumR >= 0 ? color.lime : color.red)
    row(10, "Open trade", dir == 1 ? "LONG (" + lastWhy + ")" : dir == -1 ? "SHORT (" + lastWhy + ")" : "none", dir == 0 ? color.gray : color.yellow)
    row(11, "Volume data", na(volume) or nz(avgVol) == 0 ? "MISSING — VSA needs volume" : "ok", na(volume) or nz(avgVol) == 0 ? color.red : color.lime)
