// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
//
// Raja Banks-Style Signals  —  Trend + Key Level + Confirmation Candle
// ---------------------------------------------------------------------------------------------
// Rules (based on the principles Raja Banks teaches publicly; he has no official coded rulebook):
//   1. TREND      Trade only with the trend: price & EMA 50 above EMA 200 (longs) / below (shorts),
//                 optionally confirmed by the higher-timeframe EMA 200.
//   2. KEY LEVEL  Price pulls back INTO a key support (longs) / resistance (shorts) zone.
//                 Key levels = prior swing highs/lows; old resistance becomes new support (break & retest).
//   3. CONFIRM    A confirmation candle closes at the level: engulfing or pin bar (rejection wick).
//   4. ENTRY      At the close of the confirmation candle.
//   5. STOP       Beyond the key-level zone / confirmation wick + small ATR buffer.
//   6. TARGETS    TP1 = 2R, TP2 = 3R, TP3 = 5R (1/3 off at each). SL → break-even after TP1,
//                 SL → TP1 after TP2. Only taken if there is ROOM to the next opposing level.
//
// The dashboard tracks every signal over the last N days (default 30): win rate, TP/SL hits, net R.
// Intrabar: if SL and TP are touched in the same candle, it is counted as SL (conservative).
// ---------------------------------------------------------------------------------------------
//@version=6
indicator("Raja Banks-Style Signals [Trend • Key Level • Confirmation]", shorttitle = "RB Signals",
     overlay = true, max_lines_count = 500, max_labels_count = 500)

// ═════════════════════════════════════════════════════════════════════════════════════════════
// INPUTS
// ═════════════════════════════════════════════════════════════════════════════════════════════
const string G1 = "1 · Trend"
const string G2 = "2 · Key levels"
const string G3 = "3 · Confirmation candle"
const string G4 = "4 · Entry, Stop & Targets"
const string G5 = "5 · Sessions (New York time)"
const string G6 = "6 · Stats & Visuals"
const string TZ = "America/New_York"

emaFastLen = input.int(50, "Fast EMA", minval = 5, group = G1)
emaSlowLen = input.int(200, "Slow EMA", minval = 20, group = G1)
useHTF     = input.bool(true, "Also require higher-timeframe trend", group = G1)
htfTf      = input.timeframe("60", "HTF timeframe", group = G1)

lvlLen     = input.int(10, "Key level pivot strength", minval = 3, maxval = 50, group = G2, tooltip = "Higher = fewer, more important levels.")
maxLvls    = input.int(12, "Max levels remembered", minval = 2, maxval = 40, group = G2)
zoneAtr    = input.float(0.3, "Zone half-width (× ATR)", minval = 0.05, step = 0.05, group = G2)
minTouch   = input.int(1, "Min touches to count as KEY level", minval = 1, maxval = 5, group = G2, tooltip = "2+ = only levels price has reacted to more than once.")
showLvls   = input.bool(true, "Draw key levels", group = G2)

useEng     = input.bool(true, "Engulfing candle", group = G3)
usePin     = input.bool(true, "Pin bar / rejection wick", group = G3)
pinRatio   = input.float(2.0, "Pin bar: wick ≥ × body", minval = 1, step = 0.25, group = G3)

slBuf      = input.float(0.1, "SL buffer (× ATR)", minval = 0, step = 0.05, group = G4)
minRiskAtr = input.float(0.3, "Min SL distance (× ATR)", minval = 0, step = 0.05, group = G4)
maxRiskAtr = input.float(2.5, "Max SL distance (× ATR)", minval = 0.5, step = 0.25, group = G4)
tp1R       = input.float(2.0, "TP1 (R)", minval = 0.5, step = 0.5, group = G4)
tp2R       = input.float(3.0, "TP2 (R)", minval = 0.5, step = 0.5, group = G4)
tp3R       = input.float(5.0, "TP3 (R)", minval = 0.5, step = 0.5, group = G4)
moveBE     = input.bool(true, "SL → break-even after TP1, → TP1 after TP2", group = G4)
needRoom   = input.bool(true, "Need room to next level ≥ TP1", group = G4)

useSess    = input.bool(true, "Only London & New York sessions", group = G5)
sessLon    = input.session("0200-0600", "London", group = G5)
sessNY     = input.session("0730-1130", "New York", group = G5)

statDays   = input.int(30, "Stats lookback (days)", minval = 1, maxval = 365, group = G6)
showTbl    = input.bool(true, "Show dashboard", group = G6)
showEma    = input.bool(true, "Show EMAs", group = G6)

// ═════════════════════════════════════════════════════════════════════════════════════════════
// TREND
// ═════════════════════════════════════════════════════════════════════════════════════════════
atr  = ta.atr(14)
emaF = ta.ema(close, emaFastLen)
emaS = ta.ema(close, emaSlowLen)
[hC, hE] = request.security(syminfo.tickerid, htfTf, [close[1], ta.ema(close, 200)[1]], lookahead = barmerge.lookahead_on)
trendUp = close > emaS and emaF > emaS and (not useHTF or hC > hE)
trendDn = close < emaS and emaF < emaS and (not useHTF or hC < hE)

// ═════════════════════════════════════════════════════════════════════════════════════════════
// KEY LEVELS (swing highs/lows, merged when close together; touches counted)
// ═════════════════════════════════════════════════════════════════════════════════════════════
var array<float> lvP = array.new_float()
var array<int>   lvT = array.new_int()

addLevel(float p, float tol) =>
    int idx = -1
    int n = lvP.size()
    if n > 0
        for i = 0 to n - 1
            if math.abs(lvP.get(i) - p) <= tol
                idx := i
                break
    if idx >= 0
        lvP.set(idx, (lvP.get(idx) + p) / 2)
        lvT.set(idx, lvT.get(idx) + 1)
    else
        lvP.push(p)
        lvT.push(1)
        if lvP.size() > maxLvls
            lvP.shift()
            lvT.shift()
    idx

zw = atr * zoneAtr
ph = ta.pivothigh(high, lvlLen, lvlLen)
pl = ta.pivotlow(low, lvlLen, lvlLen)
if not na(ph) and not na(zw)
    addLevel(ph, zw * 2)
if not na(pl) and not na(zw)
    addLevel(pl, zw * 2)

// Which key levels is price interacting with right now?
float supLvl   = na     // support touched this bar (below close)
float resLvl   = na     // resistance touched this bar (above close)
float resAbove = na     // next level above (room for longs)
float supBelow = na     // next level below (room for shorts)
int nL = lvP.size()
if nL > 0 and not na(zw)
    for i = 0 to nL - 1
        float p = lvP.get(i)
        if lvT.get(i) >= minTouch
            if p < close and low <= p + zw
                supLvl := na(supLvl) ? p : math.max(supLvl, p)
            if p > close and high >= p - zw
                resLvl := na(resLvl) ? p : math.min(resLvl, p)
            if p > close + zw
                resAbove := na(resAbove) ? p : math.min(resAbove, p)
            if p < close - zw
                supBelow := na(supBelow) ? p : math.max(supBelow, p)

// ═════════════════════════════════════════════════════════════════════════════════════════════
// CONFIRMATION CANDLES
// ═════════════════════════════════════════════════════════════════════════════════════════════
rng    = high - low
bodyC  = math.abs(close - open)
bodyP  = math.abs(close[1] - open[1])
lowWk  = math.min(open, close) - low
upWk   = high - math.max(open, close)

bullEng = close > open and close[1] < open[1] and close >= open[1] and open <= close[1] and bodyC > bodyP
bearEng = close < open and close[1] > open[1] and close <= open[1] and open >= close[1] and bodyC > bodyP
bullPin = rng > 0 and lowWk >= pinRatio * bodyC and lowWk >= 0.55 * rng and close >= low + 0.6 * rng
bearPin = rng > 0 and upWk >= pinRatio * bodyC and upWk >= 0.55 * rng and close <= high - 0.6 * rng

bullConf = (useEng and bullEng) or (usePin and bullPin)
bearConf = (useEng and bearEng) or (usePin and bearPin)

// ═════════════════════════════════════════════════════════════════════════════════════════════
// SESSIONS
// ═════════════════════════════════════════════════════════════════════════════════════════════
inS(string s) => not na(time(timeframe.period, s, TZ))
sL = inS(sessLon)
sN = inS(sessNY)
inSession = not useSess or sL or sN

// ═════════════════════════════════════════════════════════════════════════════════════════════
// SIGNALS
// ═════════════════════════════════════════════════════════════════════════════════════════════
float lSL   = na(supLvl) ? na : math.min(low, supLvl - zw) - slBuf * atr
float lRisk = close - lSL
bool  lOk   = not na(lSL) and lRisk >= minRiskAtr * atr and lRisk <= maxRiskAtr * atr
bool  lRoom = not needRoom or na(resAbove) or (resAbove - close) >= tp1R * lRisk

float sSL   = na(resLvl) ? na : math.max(high, resLvl + zw) + slBuf * atr
float sRisk = sSL - close
bool  sOk   = not na(sSL) and sRisk >= minRiskAtr * atr and sRisk <= maxRiskAtr * atr
bool  sRoom = not needRoom or na(supBelow) or (close - supBelow) >= tp1R * sRisk

longSig  = barstate.isconfirmed and trendUp and inSession and bullConf and lOk and lRoom
shortSig = barstate.isconfirmed and trendDn and inSession and bearConf and sOk and sRoom

// ═════════════════════════════════════════════════════════════════════════════════════════════
// TRADE TRACKING (one trade at a time) + STATS
// ═════════════════════════════════════════════════════════════════════════════════════════════
var int   dir    = 0
var float tEntry = na
var float tRisk  = na
var float tSL    = na
var float tTP1   = na
var float tTP2   = na
var float tTP3   = na
var int   tBar   = na
var bool  h1     = false
var bool  h2     = false
var bool  tStat  = false
var line  lnE    = na
var line  lnS    = na
var line  ln1    = na
var line  ln2    = na
var line  ln3    = na

var int   nTr  = 0
var int   nWin = 0
var int   nT1  = 0
var int   nT2  = 0
var int   nT3  = 0
var int   nSL  = 0
var float sumR = 0.0

inStats = time >= timenow - statDays * 86400000

f_R(float price) => (price - tEntry) * dir / tRisk

if dir != 0 and bar_index > tBar
    bool slHit = dir == 1 ? low <= tSL : high >= tSL
    bool t1    = dir == 1 ? high >= tTP1 : low <= tTP1
    bool t2    = dir == 1 ? high >= tTP2 : low <= tTP2
    bool t3    = dir == 1 ? high >= tTP3 : low <= tTP3
    float  res = na
    string out = ""
    if slHit
        float realized = (h1 ? tp1R / 3 : 0.0) + (h2 ? tp2R / 3 : 0.0)
        float remFrac  = 1.0 - (h1 ? 1.0 / 3 : 0.0) - (h2 ? 1.0 / 3 : 0.0)
        res := realized + remFrac * f_R(tSL)
        out := h2 ? "TP2 ✓" : h1 ? "TP1 ✓" : "SL ✗"
    else
        if t1 and not h1
            h1 := true
            if moveBE
                tSL := tEntry
        if t2 and not h2
            h2 := true
            if moveBE
                tSL := tTP1
        if t3
            res := (tp1R + tp2R + tp3R) / 3
            out := "TP3 ✓"
    line.set_x2(lnE, bar_index)
    line.set_x2(lnS, bar_index)
    line.set_x2(ln1, bar_index)
    line.set_x2(ln2, bar_index)
    line.set_x2(ln3, bar_index)
    line.set_y1(lnS, tSL)
    line.set_y2(lnS, tSL)
    if not na(res)
        if tStat
            nTr  += 1
            sumR += res
            if res > 0
                nWin += 1
            if out == "TP3 ✓"
                nT3 += 1
            else if out == "TP2 ✓"
                nT2 += 1
            else if out == "TP1 ✓"
                nT1 += 1
            else
                nSL += 1
        label.new(bar_index, dir == 1 ? high : low, out + "  " + (res >= 0 ? "+" : "") + str.tostring(res, "#.##") + "R",
             style = dir == 1 ? label.style_label_down : label.style_label_up,
             color = res > 0 ? color.new(color.green, 20) : color.new(color.red, 20), textcolor = color.white, size = size.small)
        dir := 0

bool buyNow  = false
bool sellNow = false

if dir == 0 and (longSig or shortSig)
    dir    := longSig ? 1 : -1
    tEntry := close
    tRisk  := longSig ? lRisk : sRisk
    tSL    := longSig ? lSL : sSL
    tTP1   := tEntry + dir * tRisk * tp1R
    tTP2   := tEntry + dir * tRisk * tp2R
    tTP3   := tEntry + dir * tRisk * tp3R
    tBar   := bar_index
    h1     := false
    h2     := false
    tStat  := inStats
    buyNow  := longSig
    sellNow := shortSig
    lnE := line.new(bar_index, tEntry, bar_index + 1, tEntry, color = color.new(color.blue, 0), width = 2)
    lnS := line.new(bar_index, tSL, bar_index + 1, tSL, color = color.new(color.red, 0), width = 2)
    ln1 := line.new(bar_index, tTP1, bar_index + 1, tTP1, color = color.new(color.green, 40), style = line.style_dashed)
    ln2 := line.new(bar_index, tTP2, bar_index + 1, tTP2, color = color.new(color.green, 20), style = line.style_dashed)
    ln3 := line.new(bar_index, tTP3, bar_index + 1, tTP3, color = color.new(color.green, 0), width = 2)
    string why = (longSig ? (bullEng ? "Engulfing" : "Pin bar") : (bearEng ? "Engulfing" : "Pin bar")) + " @ key " + (longSig ? "support" : "resistance")
    string txt = (longSig ? "BUY" : "SELL") + "  (" + why + ")" +
         "\nEntry: " + str.tostring(tEntry, format.mintick) +
         "\nSL: "    + str.tostring(tSL, format.mintick) +
         "\nTP1: "   + str.tostring(tTP1, format.mintick) + "  (" + str.tostring(tp1R) + "R)" +
         "\nTP2: "   + str.tostring(tTP2, format.mintick) + "  (" + str.tostring(tp2R) + "R)" +
         "\nTP3: "   + str.tostring(tTP3, format.mintick) + "  (" + str.tostring(tp3R) + "R)"
    label.new(bar_index, longSig ? low : high, txt,
         style = longSig ? label.style_label_up : label.style_label_down,
         color = longSig ? color.new(color.green, 0) : color.new(color.red, 0), textcolor = color.white, size = size.small)
    alert(syminfo.ticker + " " + (longSig ? "BUY" : "SELL") + " | Entry " + str.tostring(tEntry, format.mintick) +
         " | SL " + str.tostring(tSL, format.mintick) + " | TP1 " + str.tostring(tTP1, format.mintick) +
         " | TP2 " + str.tostring(tTP2, format.mintick) + " | TP3 " + str.tostring(tTP3, format.mintick), alert.freq_once_per_bar_close)

alertcondition(buyNow, "RB Buy", "Raja Banks-style BUY signal on {{ticker}} at {{close}}")
alertcondition(sellNow, "RB Sell", "Raja Banks-style SELL signal on {{ticker}} at {{close}}")

// ═════════════════════════════════════════════════════════════════════════════════════════════
// VISUALS
// ═════════════════════════════════════════════════════════════════════════════════════════════
plot(showEma ? emaF : na, "EMA fast", color = color.new(color.orange, 0))
plot(showEma ? emaS : na, "EMA slow", color = trendUp ? color.new(color.teal, 0) : trendDn ? color.new(color.red, 0) : color.gray, linewidth = 2)

var array<line> lvLines = array.new_line()
if showLvls and barstate.islast
    while lvLines.size() > 0
        line.delete(lvLines.pop())
    int m = lvP.size()
    if m > 0
        for i = 0 to m - 1
            float p = lvP.get(i)
            int   t = lvT.get(i)
            if t >= minTouch
                color c = p < close ? color.new(color.teal, 30) : color.new(color.maroon, 30)
                lvLines.push(line.new(bar_index - 150, p, bar_index + 20, p, color = c, width = t >= 2 ? 2 : 1, style = t >= 2 ? line.style_solid : line.style_dotted))

var table tb = table.new(position.top_right, 2, 11, bgcolor = color.new(color.black, 15), border_color = color.new(color.gray, 60), border_width = 1)
row(int r, string k, string v, color c) =>
    table.cell(tb, 0, r, k, text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, r, v, text_color = c, text_size = size.small, text_halign = text.align_right)

if showTbl and barstate.islast
    float wr = nTr > 0 ? 100.0 * nWin / nTr : na
    row(0, "RB Signals", "last " + str.tostring(statDays) + " days", color.white)
    row(1, "Trend", trendUp ? "UP — buys only" : trendDn ? "DOWN — sells only" : "none — no trades", trendUp ? color.lime : trendDn ? color.red : color.gray)
    row(2, "Closed signals", str.tostring(nTr), color.white)
    row(3, "Win rate (TP1+)", na(wr) ? "—" : str.tostring(wr, "#.0") + "%", na(wr) ? color.gray : wr >= 40 ? color.lime : color.orange)
    row(4, "TP3 hit", str.tostring(nT3), color.lime)
    row(5, "TP2 then stop", str.tostring(nT2), color.lime)
    row(6, "TP1 then BE", str.tostring(nT1), color.lime)
    row(7, "Stopped out", str.tostring(nSL), color.red)
    row(8, "Net result", (sumR >= 0 ? "+" : "") + str.tostring(sumR, "#.##") + " R", sumR >= 0 ? color.lime : color.red)
    row(9, "Avg per trade", nTr > 0 ? str.tostring(sumR / nTr, "#.##") + " R" : "—", sumR >= 0 ? color.lime : color.red)
    row(10, "Open trade", dir == 1 ? "LONG" : dir == -1 ? "SHORT" : "none", dir == 0 ? color.gray : color.yellow)
